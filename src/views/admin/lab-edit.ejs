<%- include('../partials/head') %><%- include('../partials/admin-nav') %>
<form class="panel" action="/admin/labs<%= lab.id?'/'+lab.id:'' %>" method="post">
<input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="revision" value="<%= lab.revision %>">
<div class="form-grid"><label>ชื่อแล็บ<input name="title" required maxlength="160" value="<%= lab.title %>"></label>
<label>แม่แบบการจำลอง<select name="simulator"><% for(const template of templates) { %><option value="<%= template.key %>" <%= template.key===lab.simulator?'selected':'' %>><%= template.name %></option><% } %></select></label></div>
<label>คำอธิบายย่อ<input name="summary" required maxlength="400" value="<%= lab.summary %>"></label>
<label>เนื้อหาบทเรียน<textarea name="lesson" required maxlength="8000" rows="7"><%= lab.lesson %></textarea></label>
<label>คำสั่งภารกิจ<textarea name="mission" required maxlength="2000" rows="3"><%= lab.mission %></textarea></label>
<div class="form-grid"><label>ระดับเป้าหมาย (%)<input name="target" type="number" min="0" max="95" step="5" value="<%= lab.target %>" required><span class="hint">Sensor, SCADA และ Build ใช้ 25–95 ทีละ 5</span></label>
<label>ภาพปกในรายการแล็บ<select name="image_id"><% for(let i=1;i<=6;i++) { %><option value="<%= i %>" <%= lab.image_id===i?'selected':'' %>>ฉาก <%= i %></option><% } %></select></label>
<label>ลำดับแสดงผล<input name="sort_order" type="number" min="0" max="9999" value="<%= lab.sort_order %>" required></label></div>
<label class="checkbox"><input name="published" type="checkbox" <%= lab.published?'checked':'' %>> เผยแพร่ให้ผู้เรียน</label>
<p class="hint">ข้อความภารกิจควรสอดคล้องกับแม่แบบและระดับเป้าหมาย การบันทึกสร้างรุ่นเนื้อหาใหม่ ผลการฝึกเดิมยังดูได้ในรายงาน</p>
<div class="actions"><button class="button">บันทึกแล็บ</button><a href="/admin/labs">กลับรายการ</a></div></form>
<%- include('../partials/foot') %>
